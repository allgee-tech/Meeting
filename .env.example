# Keep secrets out of source control. Copy this file to .env for local use.
PORT=3000
NODE_ENV=development
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000

# Railway Volume mount path for the local JSON store. Keep .data locally.
# MEETING_DATA_DIR=/data

# SMTP credentials from your email delivery provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional alternative to SMTP; use with SMTP_FROM.
# BREVO_API_KEY=

# Optional comma-separated additional admin account email addresses.
ADMIN_EMAIL=

# Enable only when your trusted reverse proxy replaces X-Forwarded-For.
TRUST_PROXY=false

# Optional TURN server settings for difficult network conditions.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential
